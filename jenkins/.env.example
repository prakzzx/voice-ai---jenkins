# The bootstrap script creates jenkins/.env from this file and fills in the blanks.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# HTTPS clone URL of your GitHub repo, e.g. https://github.com/you/prakati.git
REPO_URL=
REPO_BRANCH=main
# Only for PRIVATE repos: a GitHub personal access token with read access to the repo
GITHUB_USER=
GITHUB_TOKEN=
# Group id of the docker group on the server (the bootstrap script sets it)
DOCKER_GID=999
