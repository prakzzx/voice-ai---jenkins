# Copy to /opt/prakati/.env on the server (the bootstrap script does this for you).
# For a local test: cp .env.example .env  and run  docker compose up --build
# Never commit the real file.

# ----- Required -----
# Your public hostname, e.g. prakati-yourname.duckdns.org ("localhost" for local tests)
DOMAIN=localhost
# Letters and digits only (the bootstrap script generates one for you)
POSTGRES_PASSWORD=change-me
VAPI_API_KEY=
# Vapi PUBLIC key (safe to expose, used by the browser)
VITE_VAPI_PUBLIC_KEY=
# The backend's LLM calls (memory extraction, stage conditions) use Groq
GROQ_API_KEY=

# ----- Optional -----
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Shared secret that must match "Server URL Secret" in the Vapi dashboard
VAPI_WEBHOOK_SECRET=
# Send leads to an external URL instead of this server's own /api/lead
LEAD_WEBHOOK_URL=
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=

# ----- Lead notifications -----
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_CHANNELS=
