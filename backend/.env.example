PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/prakati

VAPI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# ── Lead notifications (second tool: notify_lead) ──────────────────────────────
# Each channel turns on automatically when its variables are set.

# Slack: create an Incoming Webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Email (any SMTP provider: Gmail app password, SendGrid, Resend SMTP, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# Optional: restrict channels, e.g. "slack" or "email,slack". Empty = all configured.
NOTIFY_CHANNELS=

# Optional LLM settings
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=
